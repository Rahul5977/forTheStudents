# Copy to .env.local for the /live page (real backend integration).
# DEV (default) — talk to the local auth-identity dev server. No values needed:
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_AUTH_MODE=dev

# COGNITO (after `pnpm deploy:dev` in backend/) — real Hosted-UI login + real JWT:
# NEXT_PUBLIC_AUTH_MODE=cognito
# NEXT_PUBLIC_API_URL=https://<httpApiId>.execute-api.ap-south-1.amazonaws.com
# NEXT_PUBLIC_COGNITO_DOMAIN=https://sc-dev-auth.auth.ap-south-1.amazoncognito.com
# NEXT_PUBLIC_COGNITO_CLIENT_ID=<UserPoolClientId>
# NEXT_PUBLIC_COGNITO_REDIRECT=http://localhost:3000/live
