  "curriculumHighlights": [
    {
      "text": "Credit-based semester system: two regular semesters (Autumn Jul-Nov, Spring Jan-Apr) plus a summer term. A B.Tech/B.S. needs roughly 266-282 credits depending on the discipline.",
      "sources": [
        {
          "url": "https://acad.iitb.ac.in/sites/default/files/UG_RULE%20BOOK_14.08.2026.pdf",
          "title": "Rules & Regulations for Undergraduate Programmes (updated August 2026)",
          "publisher": "IIT Bombay",
          "accessedOn": "2026-09-13",
          "asOf": "2026-08",
          "confidence": "official"
        }
      ],
      "asOf": "2026-08"
    },
    {
      "text": "No branch change into JoSAA-admitted branches for students admitted from JEE (Advanced) 2023 onwards; the only post-first-year switch is into the LASE (Liberal Arts, Sciences, Engineering) B.S. track.",
      "sources": [
        {
          "url": "https://acad.iitb.ac.in/sites/default/files/UG_RULE%20BOOK_14.08.2026.pdf",
          "title": "Rules & Regulations for Undergraduate Programmes (updated August 2026)",
          "publisher": "IIT Bombay",
          "accessedOn": "2026-09-13",
          "asOf": "2026-08",
          "confidence": "official"
        }
      ],
      "asOf": "2026-08"
    },
    {
      "text": "Minor: 30 extra credits in another department, pre-registered and allotted by CPI, printed on the degree as 'with Minor in ...'. More than one minor is allowed if the timetable permits.",
      "sources": [
        {
          "url": "https://acad.iitb.ac.in/sites/default/files/UG_RULE%20BOOK_14.08.2026.pdf",
          "title": "Rules & Regulations for Undergraduate Programmes (updated August 2026)",
          "publisher": "IIT Bombay",
          "accessedOn": "2026-09-13",
          "asOf": "2026-08",
          "confidence": "official"
        }
      ],
      "asOf": "2026-08"
    },
    {
      "text": "Honours: 24 additional credits of department-prescribed courses/project earns 'B.Tech ... with Honours'. Dual Degree students must complete the honours requirement as part of their programme.",
      "sources": [
        {
          "url": "https://acad.iitb.ac.in/sites/default/files/UG_RULE%20BOOK_14.08.2026.pdf",
          "title": "Rules & Regulations for Undergraduate Programmes (updated August 2026)",
          "publisher": "IIT Bombay",
          "accessedOn": "2026-09-13",
          "asOf": "2026-08",
          "confidence": "official"
        }
      ],
      "asOf": "2026-08"
    },
    {
      "text": "B.Tech students may convert to the 5-year Dual Degree in their own department after the 6th semester (department CPI cut-off applies); the DD project carries 72 credits over about 14 months.",
      "sources": [
        {
          "url": "https://acad.iitb.ac.in/sites/default/files/UG_RULE%20BOOK_14.08.2026.pdf",
          "title": "Rules & Regulations for Undergraduate Programmes (updated August 2026)",
          "publisher": "IIT Bombay",
          "accessedOn": "2026-09-13",
          "asOf": "2026-08",
          "confidence": "official"
        }
      ],
      "asOf": "2026-08"
    },
    {
      "text": "IDDDP lets B.Tech/B.S. students add an M.Tech, MBA or M.Sc. specialisation from another department in a 5th year: apply after semester 6 with CPI of at least 7.5; at most 2 seats per specialisation.",
      "sources": [
        {
          "url": "https://acad.iitb.ac.in/sites/default/files/IDDDP_Guidelines_2025.pdf",
          "title": "Guidelines for Interdisciplinary Dual Degree Programme (IDDDP)",
          "publisher": "IIT Bombay",
          "accessedOn": "2026-09-13",
          "asOf": "2025",
          "confidence": "official"
        }
      ],
      "asOf": "2025"
    },
    {
      "text": "Semester exchange abroad through the International Relations office, which lists 250 MoUs with global institutions; courses taken at the partner are registered and graded on return with DUGC approval.",
      "sources": [
        {
          "url": "https://www.ir.iitb.ac.in/",
          "title": "International Relations, IIT Bombay",
          "publisher": "IIT Bombay",
          "accessedOn": "2026-09-13",
          "asOf": null,
          "confidence": "official"
        },
        {
          "url": "https://acad.iitb.ac.in/sites/default/files/UG_RULE%20BOOK_14.08.2026.pdf",
          "title": "Rules & Regulations for Undergraduate Programmes (updated August 2026)",
          "publisher": "IIT Bombay",
          "accessedOn": "2026-09-13",
          "asOf": "2026-08",
          "confidence": "official"
        }
      ],
      "asOf": "2026-08"
    },
    {
      "text": "After the first year, students in good standing get about 6 credits of headroom per semester for extra courses; that is how minors, honours, a 12-credit B.Tech Project or NPTEL/SWAYAM credits fit in.",
      "sources": [
        {
          "url": "https://acad.iitb.ac.in/sites/default/files/UG_RULE%20BOOK_14.08.2026.pdf",
          "title": "Rules & Regulations for Undergraduate Programmes (updated August 2026)",
          "publisher": "IIT Bombay",
          "accessedOn": "2026-09-13",
          "asOf": "2026-08",
          "confidence": "official"
        }
      ],
      "asOf": "2026-08"
    }
  ],
  "research": {
    "note": "IIT Bombay's NIRF 2026 submission reports 3,290 full-time and 241 part-time PhD scholars enrolled up to 2024-25, with 463 full-time and 36 part-time doctorates awarded that year. Sponsored research stood at 1,707 projects worth about Rs 795 crore in 2024-25, consultancy at 1,368 projects worth about Rs 157 crore, and 298 patents were granted in 2024. The campus also hosts a Research Park.",
