  "curriculumHighlights": [
    {
      "text": "The institute reports having implemented multiple entry/exit into its programmes and having introduced dedicated Indian Knowledge System courses alongside instruction in Indian languages, as declared in its own NIRF 2025 data submission.",
      "asOf": "2024-25",
      "sources": [
        {
          "url": "https://nirf.iiitdmj.ac.in/downloads/NIRF-2025/NIRF%202025%20Overall%20report.pdf",
          "title": "NIRF 2025 Overall Data Submission",
          "publisher": "PDPM IIITDM Jabalpur (NIRF Cell)",
          "accessedOn": "2026-09-16",
          "asOf": "2024-25",
          "confidence": "official"
        }
      ]
    },
    {
      "text": "Unlike a typical engineering-only IIIT, the curriculum runs a full Design discipline (B.Des/M.Des) alongside CSE, ECE, Mechanical and Smart Manufacturing, so design students and engineering students share a campus and, in places, coursework.",
      "asOf": null,
      "sources": [
        {
          "url": "https://www.iiitdmj.ac.in/index.php/academics/departments",
          "title": "Academic Departments",
          "publisher": "PDPM IIITDM Jabalpur",
          "accessedOn": "2026-09-16",
          "asOf": null,
          "confidence": "official"
        }
      ]
    },
    {
      "text": "Natural Sciences and Liberal Arts run as supporting departments that teach foundation courses across every branch rather than awarding their own undergraduate degrees, while still running PhD programmes in physics, mathematics and English.",
      "asOf": null,
      "sources": [
        {
          "url": "https://ns.iiitdmj.ac.in/",
          "title": "Welcome to Natural Sciences",
          "publisher": "PDPM IIITDM Jabalpur",
          "accessedOn": "2026-09-16",
          "asOf": null,
          "confidence": "official"
        }
      ]
    }
  ],
  "research": {
    "note": "The institute's own 2023-24 NIRF submission lists 43 sponsored research projects worth roughly Rs. 2.76 crore from 21 funding agencies, 5 consultancy projects, and 33 patents published with 24 granted that year, alongside a full-time PhD cohort spread across all seven departments.",
