# ── Copy to .env.<stage>.local and fill. Never commit real secrets. ──
# Deployment
STAGE=dev
AWS_REGION=ap-south-1

# DynamoDB (table names are output by the CDK data stack; for local dev use DynamoDB Local)
DDB_ENDPOINT=http://localhost:8000        # local only; leave empty in AWS
TABLE_USERS=sc-dev-users

# Cognito (output by the CDK auth stack after first deploy)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_ISSUER=                            # https://cognito-idp.<region>.amazonaws.com/<userPoolId>

# Google federation (create in Google Cloud console; store real values in Secrets Manager for prod)
# TODO(owner): put GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET in Secrets Manager, reference by ARN in infra/lib/config.ts
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Feature flags
SEASON=on                                  # on|off — gates provisioned concurrency & expensive knobs
